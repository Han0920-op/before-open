# Example names only; the app does not automatically load this file.
# Inject a real URL securely via the process environment, never commit it here.
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
COOKIE_SECURE=true
# Explicit origins only; no wildcard. Local same-origin development can leave empty.
ALLOWED_ORIGINS=
# AI is deferred in the current product; these settings are retained for a future extension.
# Model environment variables alone cannot activate AI routes.
BO_LLM_ENABLED=false
# BO_LLM_MODEL=<model-name>
# BO_LLM_BASE_URL=https://api.openai.com/v1
# BO_LLM_API_KEY=<secure-server-only-value>
# Ordinary users do not configure models. The server uses this optional default.
# Single-process ceiling; every model attempt counts, including failed calls.
# BO_LLM_SHARED_CALL_LIMIT=100
# This counter resets on restart; use provider-side spending limits as well.
